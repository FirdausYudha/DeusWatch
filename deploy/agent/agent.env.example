# DeusWatch agent configuration. Copy to /etc/deuswatch/agent.env then adjust.

# Manager (gateway) URL, required.
GATEWAY_URL=https://manager.example:8443

# Agent mTLS certificate directory (ca.crt, client.crt, client.key).
CERT_DIR=/etc/deuswatch/certs

# Reported host name (empty = OS hostname).
HOST_NAME=

# Optional: override with a single source (otherwise use the per-OS defaults).
# LOG_FILE=/var/log/auth.log
# DATASET=sshd

# 1 = also send lines that already exist at start (default 0 = only new lines).
FROM_START=0

# Store-and-forward buffer directory (while the manager is offline).
BUFFER_DIR=/var/lib/deuswatch/buffer

# ── Signed updates and policies ────────────────────────────────────────────
# With a trusted release key installed, this agent REFUSES a self-update whose signature does
# not verify, and drops any pushed CIS policy that does not either. A compromised manager can
# then withhold updates but cannot replace this binary or run shell commands here as root.
#
# Without a key the agent updates as before and says on every update that it is unverified.
#
# The key is the operator's PUBLIC key. It is never fetched from the manager: taking it from the
# manager would mean trusting the manager to supply the key that checks the manager.
# Generate with:  dwsign -gen
#
# Either put it in $CERT_DIR/update.pub (the installer does this when passed UPDATE_PUBKEY),
# or set it here as the bare base64 of the key. See docs/signing.md.
# UPDATE_PUBKEY=
#
# Override where the key file is read from.
# UPDATE_PUBKEY_FILE=/etc/deuswatch/certs/update.pub
#
# 0 = also refuse CIS policies served by the manager entirely, running only the ones placed on
# this host. Independent of signing; for a host hardened by hand.
# SCA_ALLOW_PUSHED=1
